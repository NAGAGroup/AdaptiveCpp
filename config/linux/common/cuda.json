{
  "cuda-subdir": {
    "value": "@ACPP_CUDA_SUBDIR@"
  },
  "cuda-install-root": {
    "value": "@ACPP_CUDA_INSTALL_ROOT@",
    "envvar": "ACPP_CUDA_PATH"
  },
  "cuda-rt-subdir": {
    "value": "@ACPP_CUDA_RT_SUBDIR@"
  },
  "cuda-include-subdir": {
    "value": "@ACPP_CUDA_INCLUDE_SUBDIR@"
  },
  "cuda-bin-subdir": {
    "value": "@ACPP_CUDA_BIN_SUBDIR@"
  },
  "cuda-libdevice-subdir": {
    "value": "@ACPP_CUDA_LIBDEVICE_SUBDIR@"
  },
  "cuda-version-major": {
    "value": "@ACPP_DISCOVERED_CUDA_VERSION_MAJOR@"
  },
  "cuda-version-minor": {
    "value": "@ACPP_DISCOVERED_CUDA_VERSION_MINOR@"
  },
  "cuda-link-line": {
    "value": "@ACPP_CUDA_LINK_LINE@",
    "envvar": "ACPP_CUDA_LINK_LINE"
  },
  "cuda-cxx-flags": {
    "value": "@ACPP_CUDA_CXX_FLAGS@",
    "envvar": "ACPP_CUDA_CXX_FLAGS"
  }
}
