{
  "app-config" : 
  [
    {
      "runtime-configurable" : true,
      "value" : "@ACPP_APP_HIP_BITCODE_DIR@",
      "var" : "ACPP_HIP_DEVICE_LIBS_DIR"
    }
  ],
  "external-permissive" : 
  [
    {
      "dest" : "{{ acpp-runtime-root }}/{{ hip-subdir }}/{{ hip-rt-subdir }}",
      "files" : 
      [
        "SHARED_LIB:amdhip64",
        "SHARED_LIB:hsa-runtime64",
        "SHARED_LIB:amd_comgr",
        "SHARED_LIB:hiprtc",
        "SHARED_LIB:hiprtc-builtins",
        "SHARED_LIB:rocprofiler-register",
        "SHARED_LIB:rocm-core"
      ],
      "src" : "{{ hip-install-root }}/{{ hip-rt-subdir }}"
    },
    {
      "dest" : "{{ acpp-runtime-root }}/{{ hip-subdir }}/{{ hip-sysdeps-subdir }}",
      "files" : [ "*" ],
      "src" : "{{ hip-install-root }}/{{ hip-sysdeps-subdir }}"
    },
    {
      "dest" : "{{ acpp-runtime-root }}/{{ hip-subdir }}/{{ hip-bitcode-subdir }}",
      "files" : [ "*" ],
      "src" : "{{ hip-install-root }}/{{ hip-bitcode-subdir }}"
    },
    {
      "dest" : "{{ acpp-runtime-root }}/{{ hip-subdir }}/{{ hip-include-subdir }}",
      "files" : [ "*" ],
      "src" : "{{ hip-install-root }}/{{ hip-include-subdir }}",
      "toolchain-only" : true
    }
  ],
  "internal" : 
  [
    {
      "dest" : "{{ acpp-runtime-root }}/{{ acpp-libdir }}/hipSYCL",
      "files" : [ "SHARED_LIB:rt-backend-hip" ],
      "src" : "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL"
    },
    {
      "dest" : "{{ acpp-runtime-root }}/{{ acpp-libdir }}/hipSYCL/llvm-to-backend",
      "files" : [ "SHARED_LIB:llvm-to-amdgpu" ],
      "src" : "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL/llvm-to-backend"
    },
    {
      "dest" : "{{ acpp-runtime-root }}/{{ acpp-libdir }}/hipSYCL/bitcode",
      "files" : [ "libkernel-sscp-amdgpu-amdhsa-full.bc" ],
      "src" : "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL/bitcode"
    }
  ],
  "llvm" : 
  [
    {
      "build-mode" : "toolchain",
      "dest" : "{{ acpp-runtime-root }}/bin",
      "files" : [ "clang++" ],
      "src" : "{{ acpp-root }}/bin",
      "unless" : "hiprtc-link"
    },
    {
      "build-mode" : "toolchain",
      "dest" : "{{ acpp-runtime-root }}/{{ acpp-libdir }}/clang/{{ llvm-version-major }}/include",
      "files" : [ "*" ],
      "src" : "{{ clang-include-path }}",
      "unless" : "hiprtc-link"
    }
  ]
}
