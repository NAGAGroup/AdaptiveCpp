{
  "internal": [
    {
      "src": "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL",
      "dest": "{{ acpp-libdir }}/hipSYCL",
      "files": ["SHARED_LIB:rt-backend-hip"]
    },
    {
      "src": "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL/llvm-to-backend",
      "dest": "{{ acpp-libdir }}/hipSYCL/llvm-to-backend",
      "files": ["SHARED_LIB:llvm-to-amdgpu"]
    },
    {
      "src": "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL/bitcode",
      "dest": "{{ acpp-libdir }}/hipSYCL/bitcode",
      "files": ["libkernel-sscp-amdgpu-amdhsa-full.bc"]
    }
  ],
  "llvm": [
    {
      "build-mode": "toolchain",
      "unless": "hiprtc-link",
      "src": "{{ acpp-root }}/bin",
      "dest": "bin",
      "files": ["clang++"]
    },
    {
      "build-mode": "toolchain",
      "unless": "hiprtc-link",
      "src": "{{ clang-include-path }}",
      "dest": "{{ acpp-libdir }}/clang/{{ llvm-version-major }}/include",
      "files": ["*"]
    }
  ],
  "external-permissive": [
    {
      "src": "{{ hip-install-root }}/{{ hip-rt-subdir }}",
      "dest": "{{ hip-subdir }}/{{ hip-rt-subdir }}",
      "files": [
        "SHARED_LIB:amdhip64",
        "SHARED_LIB:hsa-runtime64",
        "SHARED_LIB:amd_comgr",
        "SHARED_LIB:hiprtc",
        "SHARED_LIB:hiprtc-builtins",
        "SHARED_LIB:rocprofiler-register",
        "SHARED_LIB:rocm-core"
      ]
    },
    {
      "src": "{{ hip-install-root }}/{{ hip-sysdeps-subdir }}",
      "dest": "{{ hip-subdir }}/{{ hip-sysdeps-subdir }}",
      "files": ["*"]
    },
    {
      "src": "{{ hip-install-root }}/{{ hip-bitcode-subdir }}",
      "dest": "{{ hip-subdir }}/{{ hip-bitcode-subdir }}",
      "files": ["*"]
    },
    {
      "src": "{{ hip-install-root }}/{{ hip-include-subdir }}",
      "dest": "{{ hip-subdir }}/{{ hip-include-subdir }}",
      "files": ["*"],
      "toolchain-only": true
    }
  ],

  "app-config": [
    {"var": "ACPP_HIP_DEVICE_LIBS_DIR", "value": "@ACPP_APP_HIP_BITCODE_SUBDIR@", "runtime-configurable": true}
  ]
}
