{
  "app-config" : 
  [
    {
      "runtime-configurable" : true,
      "value" : "@ACPP_APP_ZE_BIN_SUBDIR@",
      "var" : "ACPP_ZE_DLL_DIR"
    }
  ],
  "external-permissive" : 
  [
    {
      "dest" : "{{ ze-subdir }}/{{ ze-bin-subdir }}",
      "files" : [ "SHARED_LIB:ze_loader" ],
      "src" : "{{ ze-install-root }}/{{ ze-bin-subdir }}"
    }
  ],
  "internal" : 
  [
    {
      "dest" : "{{ acpp-bindir }}/hipSYCL",
      "files" : [ "SHARED_LIB:rt-backend-ze" ],
      "src" : "{{ acpp-root }}/{{ acpp-bindir }}/hipSYCL"
    },
    {
      "dest" : "{{ acpp-libdir }}/hipSYCL/bitcode",
      "files" : [ "libkernel-sscp-spirv-full.bc" ],
      "src" : "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL/bitcode"
    }
  ]
}
