{
  "internal": [
    {
      "src": "{{ toolchain-path }}/{{ acpp-bindir }}/hipSYCL",
      "dest": "{{ acpp-bindir }}/hipSYCL",
      "files": ["SHARED_LIB:rt-backend-cuda"]
    },
    {
      "src": "{{ toolchain-path }}/{{ acpp-bindir }}/hipSYCL/llvm-to-backend",
      "dest": "{{ acpp-bindir }}/hipSYCL/llvm-to-backend",
      "files": ["SHARED_LIB:llvm-to-ptx"]
    },
    {
      "src": "{{ toolchain-path }}/{{ acpp-libdir }}/hipSYCL/bitcode",
      "dest": "{{ acpp-libdir }}/hipSYCL/bitcode",
      "files": ["libkernel-sscp-ptx-full.bc"]
    }
  ],
  "external-nonpermissive": [
    {
      "src": "{{ cuda-bin-path }}",
      "dest": "{{ cuda-deploy-path }}/{{ cuda-bindir }}",
      "files": ["SHARED_LIB:cudart64_{{ cuda-version-major }}"]
    },
    {
      "src": "{{ cuda-libdevice-dir }}",
      "dest": "{{ cuda-deploy-path }}/nvvm/libdevice",
      "files": ["libdevice.10.bc"]
    },
    {
      "src": "{{ cuda-include-path }}",
      "dest": "{{ cuda-deploy-path }}/{{ cuda-incdir }}",
      "files": ["*"],
      "toolchain-only": true
    },
    {
      "src": "{{ cuda-lib-path }}",
      "dest": "{{ cuda-deploy-path }}/{{ cuda-libdir }}",
      "files": ["cudart.lib"],
      "toolchain-only": true
    },
    {
      "src": "{{ cuda-bin-path }}",
      "dest": "{{ cuda-deploy-path }}/{{ cuda-bindir }}",
      "files": ["ptxas.exe", "fatbinary.exe"],
      "toolchain-only": true
    }
  ]
}
