{
  "internal": [],
  "llvm": [],
  "external-permissive": [],
  "external-nonpermissive": [
    {
      "src": "{{ svml-install-root }}",
      "dest": "{{ acpp-runtime-root }}/{{ svml-subdir }}",
      "files": [
        "SHARED_LIB:svml",
        "SHARED_LIB:intlc"
      ]
    }
  ],

  "app-config": [
    {"var": "ACPP_SVML_DIR", "value": "@ACPP_APP_SVML_INSTALL_ROOT@", "runtime-configurable": true}
  ]
}
