{
  "internal": [
    {
      "src": "{{ acpp-root }}/{{ acpp-libdir }}",
      "dest": "{{ acpp-runtime-root }}/{{ acpp-libdir }}",
      "files": [
        "SHARED_LIB:acpp-rt",
        "SHARED_LIB:acpp-common"
      ]
    },
    {
      "src": "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL",
      "dest": "{{ acpp-runtime-root }}/{{ acpp-libdir }}/hipSYCL",
      "files": [
        "SHARED_LIB:rt-backend-omp"
      ]
    },
    {
      "src": "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL/llvm-to-backend",
      "dest": "{{ acpp-runtime-root }}/{{ acpp-libdir }}/hipSYCL/llvm-to-backend",
      "files": [
        "SHARED_LIB:llvm-to-backend",
        "SHARED_LIB:llvm-to-host",
        "SHARED_LIB:llvm-to-spirv"
      ]
    },
    {
      "src": "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL/bitcode",
      "dest": "{{ acpp-runtime-root }}/{{ acpp-libdir }}/hipSYCL/bitcode",
      "files": [
        "libkernel-sscp-host-full.bc",
        "libkernel-sscp-host-fast-full.bc"
      ]
    },
    {
      "src": "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL/ext/llvm-spirv/bin",
      "dest": "{{ acpp-runtime-root }}/{{ acpp-libdir }}/hipSYCL/ext/llvm-spirv/bin",
      "files": [
        "llvm-spirv"
      ]
    }
  ],

  "llvm": [
    {
      "build-mode": "toolchain",
      "src": "{{ acpp-root }}/bin",
      "dest": "{{ acpp-runtime-root }}/bin",
      "files": [
        "llc",
        "opt",
        "ld64.lld"
      ]
    },
    {
      "build-mode": "toolchain",
      "src": "{{ llvm-path }}",
      "dest": "{{ acpp-runtime-root }}/{{ acpp-libdir }}",
      "files": [
        "SHARED_LIB:LLVM"
      ]
    },
    {
      "build-mode": "toolchain",
      "src": "{{ libomp-path }}",
      "dest": "{{ acpp-runtime-root }}/{{ acpp-libdir }}",
      "files": [
        "SHARED_LIB:omp"
      ]
    }
  ],

  "external-permissive": [
    {
      "build-mode": "plugin",
      "src": "{{ libomp-install-root }}",
      "dest": "{{ acpp-runtime-root }}/{{ libomp-subdir }}",
      "files": [
        "SHARED_LIB:omp"
      ]
    }
  ],

  "external-nonpermissive": [],

  "app-config": [
    {"var": "ACPP_CLANG", "value": "@ACPP_APP_DEVICE_CMPLR@", "runtime-configurable": true},
    {"var": "ACPP_CLANG_INCLUDE_PATH", "value": "@ACPP_APP_CLANG_INCLUDE_PATH@", "runtime-configurable": false},
    {"var": "ACPP_LLC", "value": "@ACPP_APP_LLC@", "runtime-configurable": false},
    {"var": "ACPP_OPT", "value": "@ACPP_APP_OPT@", "runtime-configurable": false},
    {"var": "ACPP_LLD", "value": "@ACPP_APP_LLD@", "runtime-configurable": false},
    {"var": "ACPP_LLVMSPIRV", "value": "@ACPP_APP_LLVMSPIRV@", "runtime-configurable": false},
    {"var": "ACPP_JIT_HOST_LLC_CPU_FLAG", "value": "{{ jit-host-llc-cpu-flag }}", "runtime-configurable": true},
    {"var": "ACPP_JIT_HOST_OPT_CPU_FLAG", "value": "{{ jit-host-opt-cpu-flag }}", "runtime-configurable": true},
    {"var": "ACPP_JIT_HOST_LLC_FLAGS", "value": "{{ jit-host-llc-flags }}", "runtime-configurable": true},
    {"var": "ACPP_JIT_HOST_OPT_FLAGS", "value": "{{ jit-host-opt-flags }}", "runtime-configurable": true},
    {"var": "ACPP_JITOPT_HOST_VECTOR_MATH_LIBRARY", "value": "{{ vector-math-lib }}", "runtime-configurable": true}
  ]
}
