{
  "internal": [
    {
      "src": "{{ toolchain-path }}/{{ acpp-bindir }}",
      "dest": "{{ acpp-bindir }}",
      "files": [
        "SHARED_LIB:acpp-rt",
        "SHARED_LIB:acpp-common"
      ]
    },
    {
      "src": "{{ toolchain-path }}/{{ acpp-bindir }}/hipSYCL",
      "dest": "{{ acpp-bindir }}/hipSYCL",
      "files": [
        "SHARED_LIB:rt-backend-omp"
      ]
    },
    {
      "src": "{{ toolchain-path }}/{{ acpp-bindir }}/hipSYCL/llvm-to-backend",
      "dest": "{{ acpp-bindir }}/hipSYCL/llvm-to-backend",
      "files": [
        "SHARED_LIB:llvm-to-backend",
        "SHARED_LIB:llvm-to-host",
        "SHARED_LIB:llvm-to-spirv"
      ]
    },
    {
      "src": "{{ toolchain-path }}/{{ acpp-libdir }}/hipSYCL/bitcode",
      "dest": "{{ acpp-libdir }}/hipSYCL/bitcode",
      "files": [
        "libkernel-sscp-host-full.bc",
        "libkernel-sscp-host-fast-full.bc"
      ]
    },
    {
      "src": "{{ toolchain-path }}/{{ acpp-bindir }}/hipSYCL/ext/llvm-spirv/bin",
      "dest": "{{ acpp-bindir }}/hipSYCL/ext/llvm-spirv/bin",
      "files": [
        "llvm-spirv.exe"
      ]
    }
  ],

  "llvm": [
    {
      "build-mode": "toolchain",
      "src": "{{ llvm-path }}/bin",
      "dest": "{{ llvm-deploy-path }}/bin",
      "files": [
        "llc.exe",
        "opt.exe",
        "lld-link.exe"
      ]
    },
    {
      "build-mode": "toolchain",
      "src": "{{ libomp-path }}",
      "dest": "{{ libomp-deploy-path }}",
      "files": [
        "SHARED_LIB:libomp"
      ]
    }
  ],

  "external-permissive": [
    {
      "build-mode": "plugin",
      "src": "{{ libomp-path }}",
      "dest": "{{ libomp-deploy-path }}",
      "files": [
        "SHARED_LIB:libomp"
      ]
    }
  ],

  "external-nonpermissive": []
}
