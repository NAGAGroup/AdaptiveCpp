{
  "external-nonpermissive" : [],
  "external-permissive" : 
  [
    {
      "dest" : "{{ acpp-runtime-root }}/{{ sleef-subdir }}",
      "files" : [ "SHARED_LIB:sleefgnuabi" ],
      "src" : "{{ sleef-install-root }}"
    },
    {
      "dest" : "{{ acpp-runtime-root }}/{{ amath-subdir }}",
      "files" : [ "SHARED_LIB:amath" ],
      "src" : "{{ amath-install-root }}"
    },
    {
      "dest" : "{{ acpp-runtime-root }}/{{ libnuma-subdir }}",
      "files" : [ "SHARED_LIB:numa" ],
      "src" : "{{ libnuma-install-root }}"
    }
  ],
  "internal" : 
  [
    {
      "dest" : "{{ acpp-runtime-root }}/{{ acpp-libdir }}",
      "files" : [ "SHARED_LIB:acpp-rt", "SHARED_LIB:acpp-common" ],
      "src" : "{{ acpp-root }}/{{ acpp-libdir }}"
    },
    {
      "dest" : "{{ acpp-runtime-root }}/{{ acpp-libdir }}/hipSYCL",
      "files" : [ "SHARED_LIB:rt-backend-omp" ],
      "src" : "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL"
    },
    {
      "dest" : "{{ acpp-runtime-root }}/{{ acpp-libdir }}/hipSYCL/llvm-to-backend",
      "files" : 
      [
        "SHARED_LIB:llvm-to-backend",
        "SHARED_LIB:llvm-to-host",
        "SHARED_LIB:llvm-to-spirv"
      ],
      "src" : "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL/llvm-to-backend"
    },
    {
      "dest" : "{{ acpp-runtime-root }}/{{ acpp-libdir }}/hipSYCL/bitcode",
      "files" : [ "libkernel-sscp-host-full.bc", "libkernel-sscp-host-fast-full.bc" ],
      "src" : "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL/bitcode"
    },
    {
      "dest" : "{{ acpp-runtime-root }}/{{ acpp-libdir }}/hipSYCL/ext/llvm-spirv/bin",
      "files" : [ "llvm-spirv" ],
      "src" : "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL/ext/llvm-spirv/bin"
    }
  ],
  "llvm" : 
  [
    {
      "build-mode" : "toolchain",
      "dest" : "{{ acpp-runtime-root }}/bin",
      "files" : [ "llc", "opt", "ld.lld" ],
      "src" : "{{ acpp-root }}/bin"
    },
    {
      "build-mode" : "toolchain",
      "dest" : "{{ acpp-runtime-root }}/{{ acpp-libdir }}",
      "files" : [ "SHARED_LIB:LLVM" ],
      "src" : "{{ acpp-root }}/{{ acpp-libdir }}"
    }
  ]
}