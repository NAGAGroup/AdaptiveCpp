{
  "deployed-libs": {
    "toolchain-libdir": "stub",
    "destination": "$ACPP_LIBDIR",
    "files": [
      "hipSYCL/SHARED_LIB:rt-backend-cuda",
      "hipSYCL/llvm-to-backend/SHARED_LIB:llvm-to-ptx",
      "hipSYCL/bitcode/libkernel-sscp-ptx-full.bc",
      "hipSYCL/vendor-loaders/nvidia/SHARED_LIB:acpp-loader-cudart"
    ]
  },
  "cuda-libs": {
    "source": "$ACPP_CUDA_LIB_PATH",
    "destination": "$ACPP_PATH/targets/$ACPP_TARGET/lib",
    "files": [
      "SHARED_LIB:cudart"
    ]
  },
  "cuda-bitcode": {
    "source": "$ACPP_CUDA_DEVICE_LIBS_PATH",
    "destination": "$ACPP_PATH/lib/hipSYCL/ext/bitcode/ptx",
    "files": [
      "libdevice.10.bc"
    ]
  }
}
