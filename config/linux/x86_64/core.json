{
  "acpp-libdir": {
    "value": "@CMAKE_INSTALL_LIBDIR@"
  },
  "llvm-libdir": {
    "value": "@ACPP_DISCOVERED_LLVM_LIBDIR@"
  },
  "llvm-deploy-path": {
    "value": "@ACPP_LLVM_DEPLOY_PATH@"
  },
  "libomp-deploy-path": {
    "value": "@ACPP_LIBOMP_DEPLOY_PATH@"
  },
  "default-strategy-app-cfg-dir": {
    "value": "@ACPP_DEFAULT_STRATEGY_APP_CFG_DIR@",
    "envvar": "ACPP_DEFAULT_STRATEGY_APP_CFG_DIR"
  },
  "deployment-strategy": {
    "value": "@ACPP_DEPLOYMENT_STRATEGY@",
    "envvar": "ACPP_DEPLOYMENT_STRATEGY"
  },

  "version-major": {
    "value": "@ACPP_VERSION_MAJOR@"
  },
  "version-minor": {
    "value": "@ACPP_VERSION_MINOR@"
  },
  "version-patch": {
    "value": "@ACPP_VERSION_PATCH@"
  },
  "version-suffix": {
    "value": "@ACPP_VERSION_SUFFIX@"
  },
  "llvm-version-major": {
    "value": "@LLVM_VERSION_MAJOR@"
  },
  "plugin-linked-into-llvm": {
    "value": "@LLVM_ADAPTIVECPP_LINK_INTO_TOOLS@"
  },

  "llvm-path": {
    "value": "@ACPP_LLVM_PATH@",
    "envvar": "ACPP_LLVM_PATH"
  },
  "libomp-path": {
    "value": "@ACPP_LIBOMP_PATH@",
    "envvar": "ACPP_LIBOMP_PATH"
  },
  "libnuma-path": {
    "value": "@ACPP_LIBNUMA_PATH@",
    "envvar": "ACPP_LIBNUMA_PATH"
  },

  "device-clang-cmplr": {
    "value": "@ACPP_TOOLCHAIN_DEVICE_CMPLR@",
    "envvar": "ACPP_CLANG",
    "app": {
      "var": "ACPP_CLANG",
      "value": "@ACPP_APP_DEVICE_CMPLR@",
      "runtime-configurable": true
    }
  },
  "cpu-cxx": {
    "value": "@ACPP_CPU_CXX@",
    "envvar": "ACPP_CPU_CXX"
  },
  "clang-include-path": {
    "value": "@ACPP_TOOLCHAIN_CLANG_INCLUDE_PATH@",
    "envvar": "ACPP_CLANG_INCLUDE_PATH",
    "app": {
      "var": "ACPP_CLANG_INCLUDE_PATH",
      "value": "@ACPP_APP_CLANG_INCLUDE_PATH@",
      "runtime-configurable": false
    }
  },
  "plugin-path": {
    "value": "@ACPP_PLUGIN_PATH@",
    "envvar": "ACPP_PLUGIN_PATH"
  },

  "llc": {
    "value": "@ACPP_TOOLCHAIN_LLC@",
    "envvar": "ACPP_LLC",
    "app": {
      "var": "ACPP_LLC",
      "value": "@ACPP_APP_LLC@",
      "runtime-configurable": false
    }
  },
  "opt": {
    "value": "@ACPP_TOOLCHAIN_OPT@",
    "envvar": "ACPP_OPT",
    "app": {
      "var": "ACPP_OPT",
      "value": "@ACPP_APP_OPT@",
      "runtime-configurable": false
    }
  },
  "lld": {
    "value": "@ACPP_TOOLCHAIN_LLD@",
    "envvar": "ACPP_LLD",
    "app": {
      "var": "ACPP_LLD",
      "value": "@ACPP_APP_LLD@",
      "runtime-configurable": false
    }
  },
  "llvm-spirv": {
    "value": "@ACPP_TOOLCHAIN_LLVMSPIRV@",
    "envvar": "ACPP_LLVMSPIRV",
    "app": {
      "var": "ACPP_LLVMSPIRV",
      "value": "@ACPP_APP_LLVMSPIRV@",
      "runtime-configurable": false
    }
  },

  "jit-host-llc-cpu-flag": {
    "value": "@ACPP_JIT_HOST_LLC_CPU_FLAG@",
    "envvar": "ACPP_JIT_HOST_LLC_CPU_FLAG",
    "app": {
      "var": "ACPP_JIT_HOST_LLC_CPU_FLAG",
      "value": "{{ jit-host-llc-cpu-flag }}",
      "runtime-configurable": true
    }
  },
  "jit-host-opt-cpu-flag": {
    "value": "@ACPP_JIT_HOST_OPT_CPU_FLAG@",
    "envvar": "ACPP_JIT_HOST_OPT_CPU_FLAG",
    "app": {
      "var": "ACPP_JIT_HOST_OPT_CPU_FLAG",
      "value": "{{ jit-host-opt-cpu-flag }}",
      "runtime-configurable": true
    }
  },
  "jit-host-llc-flags": {
    "value": "@ACPP_JIT_HOST_LLC_FLAGS@",
    "envvar": "ACPP_JIT_HOST_LLC_FLAGS",
    "app": {
      "var": "ACPP_JIT_HOST_LLC_FLAGS",
      "value": "{{ jit-host-llc-flags }}",
      "runtime-configurable": true
    }
  },
  "jit-host-opt-flags": {
    "value": "@ACPP_JIT_HOST_OPT_FLAGS@",
    "envvar": "ACPP_JIT_HOST_OPT_FLAGS",
    "app": {
      "var": "ACPP_JIT_HOST_OPT_FLAGS",
      "value": "{{ jit-host-opt-flags }}",
      "runtime-configurable": true
    }
  },

  "vector-math-lib": {
    "value": "@ACPP_VECTOR_MATH_LIB@",
    "envvar": "ACPP_VECTOR_MATH_LIB",
    "app": {
      "var": "ACPP_JITOPT_HOST_VECTOR_MATH_LIBRARY",
      "value": "{{ vector-math-lib }}",
      "runtime-configurable": true
    }
  },
  "sleef-dir": {
    "value": "@ACPP_TOOLCHAIN_SLEEF_DIR@",
    "envvar": "ACPP_SLEEF_DIR",
    "app": {
      "var": "ACPP_SLEEF_DIR",
      "value": "@ACPP_APP_SLEEF_DIR@",
      "runtime-configurable": true
    }
  },
  "amath-dir": {
    "value": "@ACPP_TOOLCHAIN_AMATH_DIR@",
    "envvar": "ACPP_AMATH_DIR",
    "app": {
      "var": "ACPP_AMATH_DIR",
      "value": "@ACPP_APP_AMATH_DIR@",
      "runtime-configurable": true
    }
  },
  "svml-dir": {
    "value": "@ACPP_TOOLCHAIN_SVML_DIR@",
    "envvar": "ACPP_SVML_DIR",
    "app": {
      "var": "ACPP_SVML_DIR",
      "value": "@ACPP_APP_SVML_DIR@",
      "runtime-configurable": true
    }
  },

  "targets": {
    "value": "@ACPP_TARGETS@",
    "envvar": "ACPP_TARGETS"
  },
  "sequential-link-line": {
    "value": "@ACPP_SEQUENTIAL_LINK_LINE@",
    "envvar": "ACPP_SEQUENTIAL_LINK_LINE"
  },
  "sequential-cxx-flags": {
    "value": "@ACPP_SEQUENTIAL_CXX_FLAGS@",
    "envvar": "ACPP_SEQUENTIAL_CXX_FLAGS"
  },
  "is-dryrun": {
    "value": "@ACPP_DRYRUN@",
    "envvar": "ACPP_DRYRUN"
  },
  "save-temps": {
    "value": "@ACPP_SAVE_TEMPS@",
    "envvar": "ACPP_SAVE_TEMPS"
  },
  "is-explicit-multipass": {
    "value": "@ACPP_EXPLICIT_MULTIPASS@",
    "envvar": "ACPP_EXPLICIT_MULTIPASS"
  }
}
