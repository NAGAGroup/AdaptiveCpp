{
  "hip-bitcode-subdir" : 
  {
    "envvar" : "ACPP_HIP_DEVICE_LIBS_DIR",
    "value" : "@ACPP_HIP_BITCODE_SUBDIR@"
  },
  "hip-cxx-flags" : 
  {
    "envvar" : "ACPP_ROCM_CXX_FLAGS",
    "value" : "@ACPP_HIP_CXX_FLAGS@"
  },
  "hip-hiprtc" : 
  {
    "value" : "@ACPP_DISCOVERED_HIP_HIPRTC@"
  },
  "hip-include-subdir" : 
  {
    "value" : "@ACPP_HIP_INCLUDE_SUBDIR@"
  },
  "hip-install-root" : 
  {
    "envvar" : "ACPP_ROCM_PATH",
    "value" : "@ACPP_HIP_INSTALL_ROOT@"
  },
  "hip-link-line" : 
  {
    "envvar" : "ACPP_ROCM_LINK_LINE",
    "value" : "@ACPP_HIP_LINK_LINE@"
  },
  "hip-rt-subdir" : 
  {
    "value" : "@ACPP_HIP_RT_SUBDIR@"
  },
  "hip-subdir" : 
  {
    "value" : "@ACPP_HIP_SUBDIR@"
  },
  "hip-sysdeps-subdir" : 
  {
    "value" : "@ACPP_HIP_SYSDEPS_SUBDIR@"
  },
  "hip-version-major" : 
  {
    "value" : "@ACPP_DISCOVERED_HIP_VERSION_MAJOR@"
  },
  "hip-version-minor" : 
  {
    "value" : "@ACPP_DISCOVERED_HIP_VERSION_MINOR@"
  }
}
