{
  "ze-deploy-path": {
    "value": "@ACPP_ZE_DEPLOY_PATH@"
  },
  "ze-bindir": {
    "value": "@ACPP_DISCOVERED_ZE_BINDIR@"
  },
  "ze-path": {
    "value": "@ACPP_ZE_PATH@"
  },
  "ze-bin-path": {
    "value": "@ACPP_ZE_BIN_PATH@"
  },
  "ze-dll-dir": {
    "value": "@ACPP_TOOLCHAIN_ZE_DLL_DIR@",
    "envvar": "ACPP_ZE_DLL_DIR",
    "app": {
      "var": "ACPP_ZE_DLL_DIR",
      "value": "@ACPP_APP_ZE_DLL_DIR@",
      "runtime-configurable": true
    }
  }
}
