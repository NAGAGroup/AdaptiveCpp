{
  "app-config" : 
  [
    {
      "runtime-configurable" : true,
      "value" : "@ACPP_APP_OCL_BIN_DIR@",
      "var" : "ACPP_OCL_DLL_DIR"
    }
  ],
  "external-permissive" : 
  [
    {
      "dest" : "{{ acpp-runtime-root }}/{{ ocl-subdir }}/{{ ocl-bin-subdir }}",
      "files" : [ "SHARED_LIB:OpenCL" ],
      "src" : "{{ ocl-install-root }}/{{ ocl-bin-subdir }}"
    }
  ],
  "internal" : 
  [
    {
      "dest" : "{{ acpp-runtime-root }}/{{ acpp-bindir }}/hipSYCL",
      "files" : [ "SHARED_LIB:rt-backend-ocl" ],
      "src" : "{{ acpp-root }}/{{ acpp-bindir }}/hipSYCL"
    },
    {
      "dest" : "{{ acpp-runtime-root }}/{{ acpp-libdir }}/hipSYCL/bitcode",
      "files" : [ "libkernel-sscp-spirv-full.bc" ],
      "src" : "{{ acpp-root }}/{{ acpp-libdir }}/hipSYCL/bitcode"
    }
  ]
}
