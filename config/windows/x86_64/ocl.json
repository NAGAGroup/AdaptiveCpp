{
  "ocl-deploy-path": {
    "value": "@ACPP_OCL_DEPLOY_PATH@"
  },
  "ocl-bindir": {
    "value": "@ACPP_DISCOVERED_OCL_BINDIR@"
  },
  "ocl-path": {
    "value": "@ACPP_OCL_PATH@"
  },
  "ocl-bin-path": {
    "value": "@ACPP_OCL_BIN_PATH@"
  },
  "ocl-dll-dir": {
    "value": "@ACPP_TOOLCHAIN_OCL_DLL_DIR@",
    "envvar": "ACPP_OCL_DLL_DIR",
    "app": {
      "var": "ACPP_OCL_DLL_DIR",
      "value": "@ACPP_APP_OCL_DLL_DIR@",
      "runtime-configurable": true
    }
  }
}
